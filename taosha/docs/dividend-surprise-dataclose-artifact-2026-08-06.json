  "sources": [
    {
      "id": "profile_source",
      "label": "dividend 全量画像",
      "path": "qbase/ingest/profile_dividend.py",
      "query": {
        "engine": "PostgreSQL + Python",
        "language": "python",
        "sql": "SELECT ts_code,end_date,ann_date,div_proc,stk_div,stk_bo_rate,stk_co_rate,cash_div,cash_div_tax,record_date,ex_date,pay_date,div_listdate,imp_ann_date,base_date,base_share,update_flag FROM public.dividend_snap WHERE batch_id=(SELECT max(batch_id) FROM public.fact_batch WHERE source='tushare:dividend') ORDER BY ts_code,end_date,ann_date,div_proc,update_flag",
        "description": "从 qbase.public.dividend_snap batch 17 只读计算年度组、E1覆盖和A1/C1/D1候选漏斗。",
        "executed_at": "2026-08-06T03:18:00Z",
        "tables_used": ["qbase.public.dividend_snap", "qbase.public.fact_batch"],
        "filters": ["end_date=12-31", "ann_date<2024-07-01", "排除北交所", "E1严格单行"]
      }
    },
    {
      "id": "quality_source",
      "label": "独立 SQL 污染对账",
      "path": "taosha/docs/dividend-surprise-dataclose-report-2026-08-06.md",
      "query": {
        "engine": "PostgreSQL",
        "language": "sql",
        "sql": "WITH src AS (SELECT * FROM dividend_snap WHERE batch_id=17 AND end_date IS NOT NULL AND to_char(end_date,'MMDD')='1231' AND ann_date<DATE '2024-07-01' AND ts_code !~ '\\\\.BJ$'), g AS (SELECT ts_code,end_date,count(DISTINCT div_proc) stage_n,count(DISTINCT ann_date) ann_n,count(DISTINCT cash_div_tax) cash_n,bool_or(update_flag='1') has_flag1,count(*) FILTER (WHERE div_proc='预案' AND update_flag='0') initial_n FROM src GROUP BY ts_code,end_date) SELECT count(*) FROM g;",
        "description": "独立于画像脚本的只读 SQL，量化多阶段、多公告日、多金额、修订与初始缺失。",
        "executed_at": "2026-08-06T03:28:00Z",
        "tables_used": ["qbase.public.dividend_snap"],
        "filters": ["batch_id=17", "年度12月31日", "holdout前", "排除北交所"]
      }
    },
    {
      "id": "disclosure_source",
      "label": "巨潮官方公告原件抽核",
      "path": "qbase/ingest/verify_dividend_disclosure.py",
      "query": {
        "engine": "CNInfo official metadata/PDF + Python",
        "language": "python",
        "sql": "WITH src AS (SELECT d.* FROM public.dividend_snap d WHERE d.batch_id=(SELECT max(batch_id) FROM public.fact_batch WHERE source='tushare:dividend') AND d.end_date IS NOT NULL AND to_char(d.end_date,'MMDD')='1231' AND d.ann_date<DATE '2024-07-01' AND d.ts_code !~ '\\\\.BJ$'), grouped AS (SELECT ts_code,end_date,count(*) FILTER (WHERE div_proc='预案' AND update_flag='0') initial_n,min(ann_date) FILTER (WHERE div_proc='预案' AND update_flag='0') ann_date,min(cash_div_tax) FILTER (WHERE div_proc='预案' AND update_flag='0') cash_div_tax FROM src GROUP BY ts_code,end_date) SELECT ts_code,end_date,ann_date,cash_div_tax FROM grouped WHERE initial_n=1 AND ann_date IS NOT NULL AND cash_div_tax>0 ORDER BY extract(year FROM ann_date),ann_date,ts_code",
        "description": "按公告年等距抽样，核对同日官方原件与税前现金分红精确值；首轮失败另做同日原件和等价单位只读复核。",
        "executed_at": "2026-08-06T03:23:00Z",
        "tables_used": ["qbase.public.dividend_snap", "CNInfo official announcement metadata", "CNInfo original PDF"],
        "filters": ["严格初始预案", "cash_div_tax>0", "每公告年最多3例", "日期精确相等", "税前金额精确相等"]
      }
    },
    {
      "id": "combined_source",
      "label": "B2 起点证据合并",
      "path": "taosha/docs/dividend-surprise-dataclose-report-2026-08-06.md",
      "query": {
        "engine": "Reviewed evidence synthesis",
        "language": "text",
