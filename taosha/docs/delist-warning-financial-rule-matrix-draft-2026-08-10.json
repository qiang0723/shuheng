    {
      "conflict_id": "C02_RULE_VERSION_EFFECTIVE_DATE",
      "description": "语义制度段已经确定，但2013—2019部分不改变A1两项语义的中间修订版本仍需逐版官方正文与精确施行日，才能满足B1逐事件唯一版本。",
      "fail_closed_when": "事件日期落在尚未完成逐版索引的区间",
      "resolution_owner": "evidence_unit",
      "status": "OPEN"
    },
    {
      "conflict_id": "C03_REPORTING_YEAR_TRANSITION",
