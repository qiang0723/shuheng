  "sources": [
    {
      "id": "stage-review-snapshot",
      "label": "阿里云 experiment 台账与十条闭卷校准档（只读快照）",
      "path": "taosha/docs/stage-review-10-experiments-2026-07-31/calibration_results.csv",
      "query": {
        "engine": "PostgreSQL",
        "language": "SQL",
        "executed_at": "2026-07-31T10:57:18+08:00",
        "sql": "-- Read-only stage-review extract, executed 2026-07-31 UTC+8 against taosha.\nSET default_transaction_read_only=on;\n\nSELECT\n    exp_id,\n    family,\n    source_type,\n    verdict_power,\n    family_trial,\n    result_json->>'verdict' AS verdict,\n    result_json->>'n_events_total' AS n_events,\n    result_json->>'n_valid' AS n_valid,\n    result_json#>>'{car,main_window,n}' AS main_n,\n    result_json#>>'{car,main_window,caar}' AS caar,\n    result_json#>>'{car,main_window,adj_bmp_car}' AS adj_bmp,\n    result_json#>>'{n_eff_rho,rho_bar}' AS rho_bar,\n    result_json#>>'{n_eff_rho,kish}' AS kish_n_eff,\n    result_json#>>'{n_eff_rho,kp}' AS kp_n_eff,\n    result_json#>>'{rejections,reject_ratio}' AS reject_ratio,\n    result_json#>>'{industry_coverage,unknown_pct}' AS industry_unknown_pct\nFROM experiment\nWHERE exp_id IN (8,10,11,12,13,16,17,20,24,568)\nORDER BY done_at;\n\nSELECT status, count(*)\nFROM experiment\nGROUP BY status\nORDER BY status;\n",
        "description": "读取十条校准实验的正式 result_json 统计量，并核对 experiment 状态分布。方向命中来自各 persist/闭卷档。",
        "tables_used": [
          "taosha.experiment"
        ],
        "filters": [
          "exp_id IN (8,10,11,12,13,16,17,20,24,568)",
          "数据库会话 default_transaction_read_only=on",
          "as of 2026-07-31 UTC+8"
        ],
        "metric_definitions": [
          "方向命中率=预判方向与主窗CAAR符号一致的实验数/10",
          "真实研究SIG率=剔除synthetic_smoke后的done且SIG实验数/真实done实验数",
          "full SIG率=真实done且verdict_power=full且SIG实验数/full真实done实验数"
        ]
      }
    }
  ]
}
