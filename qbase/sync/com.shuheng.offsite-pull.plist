<?xml version="1.0" encoding="UTF-8"?>
<!-- Mac 每日异地拉取 launchd 模板(迁移改判 2026-07-28)。
     安装(把 __HOME__ 换成实际家目录后):
       sed "s|__HOME__|$HOME|g" com.shuheng.offsite-pull.plist > ~/Library/LaunchAgents/com.shuheng.offsite-pull.plist
       launchctl load ~/Library/LaunchAgents/com.shuheng.offsite-pull.plist
     04:00 触发(晚于阿里云 03:00 备份);睡眠错过=唤醒补跑(launchd 语义);关机错过靠脚本补拉。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.shuheng.offsite-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/shuheng/quant/qbase/sync/offsite_pull_mac.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/shuheng-backups/offsite.log</string>
  <key>StandardErrorPath</key><string>__HOME__/shuheng-backups/offsite.log</string>
</dict>
</plist>
